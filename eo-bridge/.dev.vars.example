# ── Local-only env for `wrangler dev` (eo-bridge) ──────────────────────────
# Copy this to .dev.vars and fill it in:   cp .dev.vars.example .dev.vars
# .dev.vars is gitignored — never commit a real key.
#
# For PRODUCTION you do NOT use this file: put the list UUIDs in wrangler.toml
# [vars] and set the key with `npx wrangler secret put EO_API_KEY`.

# Email Octopus API key (Account Settings -> API).
EO_API_KEY=eo_paste_your_key_here

# List UUIDs (Email Octopus -> Lists). Fill the lanes you want to exercise.
EO_LIST_TRADES=
EO_LIST_OWNERS=
EO_LIST_MANAGERS=
EO_LIST_STRATA=
EO_LIST_SUPPLIERS=
EO_LIST_DEFAULT=

# Allow your local static server's origin so the AJAX pricing-lock form passes
# CORS. Match the port you serve index.html on (python http.server = 8000,
# http-server = 8080, etc). Comma-separated.
ALLOWED_ORIGIN=http://localhost:8080,https://babbitt.app

# Mirror to FormSubmit during local tests too (optional — comment out to skip).
FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/db2386c230f1fd46e7c207920bbf4508
