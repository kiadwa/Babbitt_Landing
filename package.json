{
    "name": "babbitt-landing",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
        "lint:js": "eslint .",
        "lint:css": "stylelint \"**/*.css\"",
        "lint:html": "htmlhint \"index.html\" \"demo/**/*.html\" \"qrlanding/**/*.html\"",
        "test": "playwright test",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "audit:hero-scroll": "node audit-hero-scroll.mjs",
        "audit:why-scroll": "node audit-why-scroll.mjs",
        "audit:demo-split": "node audit-demo-split.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@playwright/test": "^1.59.1",
        "eslint": "^9.13.0",
        "globals": "^15.11.0",
        "htmlhint": "^1.1.4",
        "playwright": "^1.59.1",
        "stylelint": "^16.10.0",
        "stylelint-config-standard": "^36.0.1"
    }
}
