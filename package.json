{
  "name": "babbitt-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "prelint": "npm run build:tailwind",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:html": "htmlhint \"index.html\" \"demo/**/*.html\" \"qrlanding/**/*.html\"",
    "pretest": "npm run build:tailwind",
    "test": "playwright test",
    "posttest": "node audit-lib/run-all.mjs",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "audit:all": "node audit-lib/run-all.mjs",
    "audit:hero-scroll": "node audit-hero-scroll.mjs",
    "audit:why-scroll": "node audit-why-scroll.mjs",
    "audit:demo-split": "node audit-demo-split.mjs",
    "build:tailwind": "tailwindcss -i demo/src/tailwind.css -o demo/tailwind.css --minify",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.59.1",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "htmlhint": "^1.1.4",
    "husky": "^9.1.7",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "tailwindcss": "^3.4.19"
  }
}
